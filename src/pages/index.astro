
---
const categories = [
  {
    number: "01",
    title: "Football",
    description: "Test your football knowledge.",
    icon: "F",
    color: "football",
    quizzes: "12 QUIZZES",
  },
  {
    number: "02",
    title: "Anime",
    description: "How well do you know your favorite anime?",
    icon: "A",
    color: "anime",
    quizzes: "10 QUIZZES",
  },
  {
    number: "03",
    title: "Personality",
    description: "Discover something new about yourself.",
    icon: "P",
    color: "personality",
    quizzes: "8 QUIZZES",
  },
];

const featured = [
  {
    category: "FOOTBALL",
    title: "Guess the Football Player",
    description: "Can you recognize the stars from their careers?",
    icon: "01",
    color: "featured-football",
    time: "5 MIN",
    href: "/quiz/football/",
  },
  {
    category: "ANIME",
    title: "Which Anime Character Are You?",
    description: "Find the character that matches your personality.",
    icon: "02",
    color: "featured-anime",
    time: "3 MIN",
    href: null,
  },
  {
    category: "PERSONALITY",
    title: "What's Your True Strength?",
    description: "Discover what makes you stand out.",
    icon: "03",
    color: "featured-personality",
    time: "2 MIN",
    href: null,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="PlayMind is your home for fun football quizzes, anime challenges, and personality tests."
    />
    <meta name="theme-color" content="#101014" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <title>PlayMind — Play. Think. Discover.</title>
  </head>

  <body>
    <header class="header">
      <a class="logo" href="/" aria-label="PlayMind home">
        <span class="logo-icon">P</span>
        <span>Play<span class="logo-light">Mind</span></span>
      </a>

      <nav class="nav" aria-label="Main navigation">
        <a href="#categories">Categories</a>
        <a href="#popular">Popular quizzes</a>
        <a href="#about">About</a>
      </nav>

      <a class="header-button" href="#popular">Start playing</a>
    </header>

    <main>
      <section class="hero">
        <div class="hero-content">
          <div class="eyebrow">
            <span class="live-dot"></span>
            YOUR NEXT CHALLENGE STARTS HERE
          </div>

          <h1>Play more.<br />Know <span class="accent-text">more.</span></h1>

          <p class="hero-description">
            Football debates, anime challenges, and personality tests.
            Find your thing, test your knowledge, and challenge yourself.
          </p>

          <div class="hero-actions">
            <a class="button button-primary" href="#popular">Explore quizzes</a>
            <a class="button button-secondary" href="#categories">Browse categories</a>
          </div>

          <div class="hero-stats">
            <div><strong>3</strong><span>MAIN CATEGORIES</span></div>
            <div class="stat-divider"></div>
            <div><strong>∞</strong><span>WAYS TO PLAY</span></div>
            <div class="stat-divider"></div>
            <div><strong>100%</strong><span>FOR THE FUN</span></div>
          </div>
        </div>

        <div class="hero-art" aria-label="PlayMind quiz categories">
          <div class="art-glow"></div>
          <div class="orbit orbit-one"></div>
          <div class="orbit orbit-two"></div>

          <div class="floating-card card-top">
            <span class="mini-icon">⚡</span>
            <div>
              <strong>Anime challenge</strong>
              <small>Test your knowledge</small>
            </div>
          </div>

          <div class="central-emblem">
            <div class="emblem-ring"></div>
            <div class="emblem-inner">
              <span class="emblem-symbol">P<span>!</span></span>
              <span class="emblem-caption">READY TO PLAY?</span>
            </div>
          </div>

          <div class="floating-card card-bottom">
            <span class="mini-icon">⚽</span>
            <div>
              <strong>Football quiz</strong>
              <small>How much do you know?</small>
            </div>
          </div>

          <span class="spark spark-one">✦</span>
          <span class="spark spark-two">✧</span>
        </div>
      </section>

      <section class="section" id="categories">
        <div class="section-heading">
          <div>
            <div class="section-label">PICK YOUR PLAYGROUND</div>
            <h2>What are you <span>into?</span></h2>
          </div>
          <p>Three worlds. Endless things to discover.</p>
        </div>

        <div class="category-grid">
          {categories.map((category) => (
            <a class={`category-card ${category.color}`} href="#popular">
              <div class="category-number">{category.number} / 03</div>
              <div class="category-icon">{category.icon}</div>
              <h3>{category.title}</h3>
              <p>{category.description}</p>
              <div class="category-bottom">
                <span>{category.quizzes}</span>
                <span class="category-go">Explore</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="section popular" id="popular">
        <div class="section-heading">
          <div>
            <div class="section-label">FIND YOUR NEXT OBSESSION</div>
            <h2>Popular <span>quizzes.</span></h2>
          </div>
          <span class="coming-soon">MORE QUIZZES COMING SOON</span>
        </div>

        <div class="quiz-grid">
          {featured.map((quiz) => (
            <article class="quiz-card">
              <div class={`quiz-art ${quiz.color}`}>
                <span class="quiz-art-icon">{quiz.icon}</span>
                <span class="quiz-time">{quiz.time}</span>
              </div>

              <div class="quiz-info">
                <span class="quiz-category">{quiz.category}</span>
                <h3>{quiz.title}</h3>
                <p>{quiz.description}</p>

                {quiz.href ? (
                  <a class="quiz-button quiz-button-active" href={quiz.href}>
                    Play quiz
                  </a>
                ) : (
                  <button class="quiz-button" disabled>
                    Coming soon
                  </button>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="about" id="about">
        <div class="about-mark">P<span>!</span></div>
        <div class="about-content">
          <div class="section-label">WELCOME TO PLAYMIND</div>
          <h2>Curiosity looks good on you.</h2>
          <p>
            A place to challenge what you know, discover what you love,
            and learn something unexpected along the way.
          </p>
        </div>
        <a class="about-link" href="#categories">Find your category</a>
      </section>
    </main>

    <footer class="footer">
      <a class="logo footer-logo" href="/">
        <span class="logo-icon">P</span>
        <span>Play<span class="logo-light">Mind</span></span>
      </a>
      <p>Play. Think. Discover.</p>
      <span>© 2026 PlayMind</span>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
  }

  :global(body) {
    margin: 0;
    background: #101014;
    color: #f5f5f7;
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 15px;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :global(button) {
    font: inherit;
  }

  :global(a:focus-visible),
  :global(button:focus-visible) {
    outline: 3px solid #ffb16f;
    outline-offset: 4px;
  }

  .header {
    min-height: 76px;
    padding: 12px 7.2%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1px solid #26262d;
    background: #101014;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.8px;
  }

  .logo-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: #ff8a35;
    color: #17130f;
    font-size: 22px;
    font-weight: 900;
  }

  .logo-light {
    color: #ff8a35;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 30px;
    color: #c1c1ca;
    font-size: 14px;
    font-weight: 500;
  }

  .nav a,
  .about-link {
    transition: color 160ms ease;
  }

  .nav a:hover,
  .about-link:hover {
    color: #ff8a35;
  }

  .header-button {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    border: 1px solid #45454e;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 700;
    transition: border-color 160ms ease, background 160ms ease;
  }

  .header-button:hover {
    border-color: #ff8a35;
    background: #1c1c22;
  }

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 20px;
    min-height: 510px;
    padding: 65px 9% 55px;
    overflow: hidden;
    border-bottom: 1px solid #26262d;
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .eyebrow,
  .section-label {
    color: #ff9a50;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    line-height: 1.6;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .live-dot {
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #ff8a35;
  }

  .hero h1 {
    margin: 24px 0 18px;
    font-size: clamp(52px, 6.2vw, 82px);
    line-height: 1.04;
    letter-spacing: -4px;
    font-weight: 900;
  }

  .accent-text,
  .section-heading h2 span {
    color: #ff8a35;
  }

  .hero-description {
    max-width: 460px;
    color: #b6b6c0;
    font-size: 15px;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
    border: 1px solid transparent;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 700;
    text-align: center;
    transition: background 160ms ease, border-color 160ms ease;
  }

  .button-primary {
    background: #ff8a35;
    color: #17130f;
  }

  .button-primary:hover {
    background: #ffa15b;
  }

  .button-secondary {
    border-color: #45454e;
    color: #ededf1;
  }

  .button-secondary:hover {
    border-color: #ff8a35;
    background: #1c1c22;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 42px;
  }

  .hero-stats div:not(.stat-divider) {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hero-stats strong {
    font-size: 21px;
    letter-spacing: -0.5px;
  }

  .hero-stats div span {
    color: #a1a1ac;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.7px;
  }

  .stat-divider {
    width: 1px;
    height: 32px;
    background: #34343b;
  }

  .hero-art {
    position: relative;
    display: grid;
    min-height: 365px;
    place-items: center;
  }

  .art-glow {
    position: absolute;
    width: 280px;
    height: 280px;
    border-radius: 50%;
    background: #ff8a3512;
    filter: blur(55px);
  }

  .orbit {
    position: absolute;
    width: 300px;
    height: 300px;
    border: 1px solid #ff8a3525;
    border-radius: 50%;
  }

  .orbit-two {
    width: 230px;
    height: 230px;
    border-color: #ffffff20;
  }

  .central-emblem {
    position: relative;
    display: grid;
    width: 180px;
    height: 180px;
    place-items: center;
    border: 1px solid #ff8a3560;
    border-radius: 32px;
    background: linear-gradient(145deg, #2a211b, #18181f 65%);
    box-shadow: 0 0 65px #ff8a3510;
    transform: rotate(-6deg);
  }

  .emblem-ring {
    position: absolute;
    inset: 12px;
    border: 1px dashed #ff8a3555;
    border-radius: 24px;
  }

  .emblem-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    transform: rotate(6deg);
  }

  .emblem-symbol {
    font-size: 70px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: -7px;
    color: #ff8a35;
  }

  .emblem-symbol span,
  .about-mark span {
    color: #fff;
  }

  .emblem-caption {
    color: #c3c3cc;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.3px;
  }

  .floating-card {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px;
    border: 1px solid #393942;
    border-radius: 12px;
    background: #1c1c23;
    box-shadow: 0 14px 45px #0005;
  }

  .card-top {
    top: 45px;
    right: -2px;
  }

  .card-bottom {
    bottom: 42px;
    left: -5px;
  }

  .mini-icon {
    display: grid;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    place-items: center;
    border-radius: 9px;
    background: #ff8a3518;
    font-size: 20px;
  }

  .floating-card div {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .floating-card strong {
    font-size: 12px;
  }

  .floating-card small {
    color: #b0b0ba;
    font-size: 11px;
  }

  .spark {
    position: absolute;
    color: #ff8a35;
  }

  .spark-one {
    top: 55px;
    left: 23%;
    font-size: 24px;
  }

  .spark-two {
    right: 9%;
    bottom: 65px;
    color: #fff;
    font-size: 28px;
  }

  .section {
    padding: 72px 9%;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }

  .section-heading h2,
  .about h2 {
    margin: 12px 0 0;
    font-size: clamp(28px, 3.2vw, 38px);
    font-weight: 800;
    letter-spacing: -1.3px;
    line-height: 1.2;
  }

  .section-heading > p {
    margin: 0 0 4px;
    color: #b0b0ba;
    font-size: 14px;
  }

  .category-grid,
  .quiz-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .category-card {
    display: flex;
    min-height: 235px;
    flex-direction: column;
    padding: 22px;
    border: 1px solid #35353e;
    border-radius: 14px;
    background: #19191f;
    transition: border-color 160ms ease, background 160ms ease;
  }

  .category-card:hover {
    border-color: #777780;
    background: #1d1d24;
  }

  .category-number {
    color: #a5a5af;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
  }

  .category-icon {
    display: grid;
    width: 50px;
    height: 50px;
    margin-top: 20px;
    place-items: center;
    border-radius: 12px;
    background: #ff8a3518;
    font-size: 26px;
  }

  .anime .category-icon {
    background: #ffffff12;
  }

  .personality .category-icon {
    background: #ff8a3525;
  }

  .category-card h3 {
    margin: 15px 0 8px;
    font-size: 20px;
    letter-spacing: -0.4px;
  }

  .category-card p {
    margin: 0 0 22px;
    color: #b6b6c0;
    font-size: 14px;
    line-height: 1.65;
  }

  .category-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid #35353e;
  }

  .category-bottom > span:first-child {
    color: #a5a5af;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
  }

  .category-go {
    color: #ff9a50;
    font-size: 13px;
    font-weight: 700;
  }

  .popular {
    padding-top: 45px;
    border-top: 1px solid #26262d;
  }

  .coming-soon {
    margin-bottom: 5px;
    padding: 10px 12px;
    border: 1px solid #41414a;
    border-radius: 7px;
    color: #c0c0c9;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  .quiz-card {
    overflow: hidden;
    border: 1px solid #35353e;
    border-radius: 14px;
    background: #19191f;
  }

  .quiz-art {
    position: relative;
    display: grid;
    min-height: 155px;
    place-items: center;
  }

  .featured-football {
    background: radial-gradient(ellipse at 50% 120%, #ff8a3540, transparent 65%), #26211d;
  }

  .featured-anime {
    background: radial-gradient(ellipse at 50% 120%, #ffffff20, transparent 65%), #24242b;
  }

  .featured-personality {
    background: radial-gradient(ellipse at 50% 120%, #ff8a3540, transparent 65%), #30221c;
  }

  .quiz-art-icon {
    font-size: 61px;
  }

  .quiz-time {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 7px 9px;
    border: 1px solid #ffffff25;
    border-radius: 6px;
    background: #101014a8;
    font-size: 10px;
    font-weight: 700;
  }

  .quiz-info {
    padding: 20px;
  }

  .quiz-category {
    color: #ff9a50;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
  }

  .quiz-info h3 {
    margin: 11px 0 9px;
    font-size: 18px;
    line-height: 1.4;
    letter-spacing: -0.3px;
  }

  .quiz-info p {
    min-height: 46px;
    margin: 0;
    color: #b6b6c0;
    font-size: 14px;
    line-height: 1.65;
  }

  .quiz-button {
    display: flex;
    width: 100%;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    margin-top: 20px;
    padding: 12px 16px;
    border: 1px solid #41414a;
    border-radius: 9px;
    background: #222229;
    color: #b6b6c0;
    font-size: 14px;
    font-weight: 700;
    text-align: center;
    cursor: not-allowed;
  }

  .quiz-button-active {
    border-color: #ff8a35;
    background: #ff8a35;
    color: #17130f;
    cursor: pointer;
    transition: background 160ms ease;
  }

  .quiz-button-active:hover {
    background: #ffa15b;
  }

  .about {
    display: flex;
    align-items: center;
    gap: 24px;
    margin: 0 9% 65px;
    padding: 30px;
    border: 1px solid #35353e;
    border-radius: 15px;
    background: linear-gradient(110deg, #282019, #19191f 65%);
  }

  .about-mark {
    display: grid;
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    place-items: center;
    border: 1px solid #ff8a3555;
    border-radius: 16px;
    color: #ff8a35;
    font-size: 36px;
    font-weight: 900;
    letter-spacing: -4px;
  }

  .about-content {
    min-width: 0;
  }

  .about h2 {
    margin-top: 8px;
    font-size: 24px;
  }

  .about p {
    max-width: 520px;
    margin: 9px 0 0;
    color: #b6b6c0;
    font-size: 14px;
    line-height: 1.7;
  }

  .about-link {
    flex-shrink: 0;
    margin-left: auto;
    color: #ff9a50;
    font-size: 14px;
    font-weight: 700;
  }

  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 25px 7.2%;
    border-top: 1px solid #26262d;
  }

  .footer-logo {
    font-size: 19px;
  }

  .footer-logo .logo-icon {
    width: 30px;
    height: 30px;
    font-size: 18px;
  }

  .footer p,
  .footer > span {
    color: #a5a5af;
    font-size: 12px;
  }

  @media (min-width: 1500px) {
    .hero,
    .section {
      padding-right: max(9%, calc((100% - 1250px) / 2));
      padding-left: max(9%, calc((100% - 1250px) / 2));
    }
  }

  @media (max-width: 900px) {
    .header {
      padding-right: 5%;
      padding-left: 5%;
    }

    .hero,
    .section {
      padding-right: 5%;
      padding-left: 5%;
    }

    .hero h1 {
      font-size: 60px;
      letter-spacing: -3px;
    }

    .hero-art {
      transform: scale(0.9);
    }

    .category-grid,
    .quiz-grid {
      gap: 12px;
    }

    .category-card,
    .quiz-info {
      padding: 16px;
    }

    .about {
      margin-right: 5%;
      margin-left: 5%;
    }
  }

  @media (max-width: 650px) {
    .header {
      min-height: 68px;
    }

    .logo {
      font-size: 20px;
    }

    .nav {
      display: none;
    }

    .header-button {
      min-height: 44px;
      padding: 0 13px;
